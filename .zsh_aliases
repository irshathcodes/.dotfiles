alias gs="git status"
alias gc="git commit"
alias gcm="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gfo="git fetch origin"
alias gco="git checkout"
alias gcob="git checkout -b"
alias gd="hunk diff"
alias gds="hunk diff --staged"
alias gl="git log --oneline"
alias glg="git log --graph --oneline"
alias glog="git log --graph --pretty=format:'%C(yellow)%h%C(reset) - %C(cyan)%an%C(reset), %C(green)%ar%C(reset) : %s'"
alias nosleep="sudo pmset -a disablesleep 1"
alias rsleep="sudo pmset -a disablesleep 0"

